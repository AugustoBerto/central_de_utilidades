{
  "name": "painel-utilidades",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace backend",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspace frontend",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "eslint": "9.31.0",
    "eslint-plugin-vue": "10.2.0",
    "globals": "16.0.0",
    "prettier": "3.5.3"
  },
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  }
}
