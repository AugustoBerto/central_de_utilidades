NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY_HOPS=1
DATABASE_PATH=./data/app.sqlite
FILES_DIR=./data/files
TEMP_UPLOAD_DIR=./data/files/.tmp
MAX_UPLOAD_BYTES=2147483648
APP_ENCRYPTION_KEY=
BOOTSTRAP_TOKEN=
SESSION_COOKIE_NAME=panel_session
SESSION_IDLE_DAYS=180
SESSION_ABSOLUTE_DAYS=365
SESSION_ROTATION_HOURS=24
COOKIE_SECURE=false
SYSTEM_METRICS_MODE=local
METRICS_SAMPLE_INTERVAL_SECONDS=5
METRICS_RETENTION_HOURS=24
ALLOW_HTTP_SHORTCUTS=false
AUTOMATIONS_ENABLED=false
